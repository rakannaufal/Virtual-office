{
  "name": "rn-group-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "three": "^0.180.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
